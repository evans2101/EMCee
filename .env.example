# Server-only: point to the Yukauto API that contains the EMCee monitoring endpoints.
YUKAUTO_API_URL=http://127.0.0.1:8080/api/v1

# Optional external link to the existing Yukauto dashboard.
YUKAUTO_WEB_URL=

# Public Cloudflare Turnstile site key, required if Yukauto login enforces CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
